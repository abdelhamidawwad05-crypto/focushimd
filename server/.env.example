PORT=5000
# Local: leave empty to use SQLite
# Production: add Postgres URL from Neon/Supabase/Render
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# REQUIRED in production: long random string used to sign session JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# NODE_ENV=production (set automatically by Render)

# REQUIRED to send verification emails via Brevo transactional API
# (server-side only — never expose this to the frontend).
# BREVO_API_KEY=xsmtpsib-...
# Optional: customize the sender shown in the email.
# BREVO_SENDER_EMAIL=noreply@focushimd.site
# BREVO_SENDER_NAME=Focus Himd
